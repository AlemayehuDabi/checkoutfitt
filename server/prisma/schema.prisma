// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  attachments   Attachment[]
  closetItems   ClosetItem[]
  outfits       Outfit[]
  chatMessages  ChatMessage[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// App-specific profile data collected during style-quiz onboarding.
/// Kept separate from Better Auth's `user` table (which Better Auth owns and
/// regenerates via `npx auth generate`) so this module's fields never collide
/// with Better Auth's own schema management.
model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  genderPresentation  String?
  stylePreferences    String[] @default([])
  sizeTop             String?
  sizeBottom          String?
  sizeShoe            String?
  onboardingCompleted Boolean  @default(false)
  // Location for weather-based outfit suggestions (Phase 5). Both lat/lng
  // must be set together — WeatherService needs coordinates, not just a name.
  latitude            Float?
  longitude           Float?
  city                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("profile")
}

enum AttachmentPurpose {
  CLOSET_ITEM
  CHAT_ATTACHMENT
  AVATAR
  OTHER
}

/// A Cloudinary asset the client uploaded directly (signed upload), recorded
/// here after the fact so other modules (closet items, chat) can reference it
/// by relation instead of juggling raw Cloudinary URLs everywhere.
model Attachment {
  id        String            @id @default(cuid())
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  publicId  String            @unique
  url       String
  secureUrl String
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  purpose   AttachmentPurpose @default(OTHER)
  createdAt DateTime          @default(now())

  closetItems ClosetItem[]

  @@index([ownerId])
  @@map("attachment")
}

enum ClosetItemStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ClosetItemType {
  TOP
  BOTTOM
  OUTERWEAR
  DRESS
  FOOTWEAR
  ACCESSORY
  BAG
  OTHER
}

/// A single garment in a user's digital closet. Created immediately on
/// ingestion with status PENDING; the BullMQ detection worker fills in
/// type/category/color/tags asynchronously via VisionService.
model ClosetItem {
  id            String           @id @default(cuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  imageUrl      String
  attachmentId  String?
  attachment    Attachment?      @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  type          ClosetItemType?
  category      String?
  color         String?
  tags          String[]         @default([])
  status        ClosetItemStatus @default(PENDING)
  failureReason String?
  archived      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  outfits Outfit[] @relation("OutfitItems")

  @@index([ownerId])
  @@index([ownerId, archived])
  @@map("closet_item")
}

/// `context` is a plain validated string (see OUTFIT_CONTEXTS in
/// src/outfit/constants.ts) rather than a Prisma enum, since Phase 6 extends
/// the occasion taxonomy — a TS const array can grow without a migration.
model Outfit {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  context     String
  items       ClosetItem[] @relation("OutfitItems")
  explanation String
  saved       Boolean      @default(false)
  createdAt   DateTime     @default(now())

  chatMessages ChatMessage[]

  @@index([ownerId])
  @@index([ownerId, saved])
  @@map("outfit")
}

enum ChatRole {
  USER
  ASSISTANT
}

/// One persistent chat thread per user (no multi-thread support) with the AI
/// stylist. An assistant message may carry an `outfitCard` when the model
/// used the generate_outfit tool while composing its reply.
model ChatMessage {
  id               String    @id @default(cuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  role             ChatRole
  content          String
  attachedImageUrl String?
  outfitCardId     String?
  outfitCard       Outfit?   @relation(fields: [outfitCardId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([ownerId, createdAt])
  @@map("chat_message")
}
