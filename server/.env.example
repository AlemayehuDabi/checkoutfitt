# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/checkoutfitt?schema=public"

# --- Better Auth --------------------------------------------------------------
# Random 32+ char secret used to sign sessions/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Publicly reachable base URL of this API (used to build OAuth callback URLs).
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000

# --- Google sign-in -----------------------------------------------------------
# Native Google Sign-In issues a different client ID per platform; only the
# ones you actually use need to be set. GOOGLE_CLIENT_SECRET is required for
# the google provider to be enabled at all.
GOOGLE_CLIENT_SECRET=""
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# --- Apple sign-in --------------------------------------------------------------
# All four are required together for the apple provider to be enabled.
# APPLE_CLIENT_ID: the Service ID (e.g. com.yourcompany.checkoutfitt.si)
# APPLE_TEAM_ID: Apple Developer Team ID
# APPLE_KEY_ID: ID of the Sign in with Apple private key
# APPLE_PRIVATE_KEY: contents of the downloaded .p8 key (escape newlines as \n)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# Your app's bundle identifier (e.g. com.yourcompany.checkoutfitt), required
# for native iOS sign-in with ID tokens.
APPLE_APP_BUNDLE_IDENTIFIER=""

# --- Redis / BullMQ / cache -----------------------------------------------------
# Backs BullMQ job queues (image detection, generation jobs) and CacheService
# (weather lookups, daily outfit suggestions).
REDIS_URL="redis://localhost:6379"

# --- Cloudinary -------------------------------------------------------------
# Find these on your Cloudinary dashboard (console.cloudinary.com).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AI providers -------------------------------------------------------------
# VisionService (garment detection) and LLMService (outfit generation, chat)
# are both provider-agnostic — set which vendor each one calls here. Only the
# selected provider's API key is actually required at runtime.
VISION_PROVIDER="gemini"      # anthropic | openai | gemini
LLM_PROVIDER="gemini"         # anthropic | openai | gemini

ANTHROPIC_API_KEY=""
# Optional per-capability model overrides (sensible defaults are used if unset).
ANTHROPIC_VISION_MODEL="claude-sonnet-5"
ANTHROPIC_LLM_MODEL="claude-sonnet-5"

OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-5.1"
OPENAI_LLM_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.5-flash-image"
GEMINI_LLM_MODEL="gemini-2.5-flash"

# --- Weather -------------------------------------------------------------------
# OpenWeather One Call API 3.0 key (openweathermap.org/api/one-call-3).
OPENWEATHER_API_KEY=""